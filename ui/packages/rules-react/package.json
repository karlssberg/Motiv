{
  "name": "@motiv-rules/react",
  "version": "0.1.0",
  "description": "Headless React adapter for @motiv-rules/core.",
  "license": "MIT",
  "author": "Daniel Karlsson",
  "homepage": "https://karlssberg.github.io/Motiv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karlssberg/Motiv.git",
    "directory": "ui/packages/rules-react"
  },
  "bugs": {
    "url": "https://github.com/karlssberg/Motiv/issues"
  },
  "keywords": [
    "motiv",
    "rules-engine",
    "specification-pattern",
    "headless",
    "rules",
    "react",
    "hooks"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./workflow": {
      "types": {
        "import": "./dist/workflow/index.d.ts",
        "require": "./dist/workflow/index.d.cts"
      },
      "import": "./dist/workflow/index.js",
      "require": "./dist/workflow/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@motiv-rules/core": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
