{
  "name": "@motiv-rules/core",
  "version": "0.1.0",
  "description": "Headless, framework-free core for building Motiv rules-engine UIs.",
  "license": "MIT",
  "author": "Daniel Karlsson",
  "homepage": "https://karlssberg.github.io/Motiv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karlssberg/Motiv.git",
    "directory": "ui/packages/rules-core"
  },
  "bugs": {
    "url": "https://github.com/karlssberg/Motiv/issues"
  },
  "keywords": [
    "motiv",
    "rules-engine",
    "specification-pattern",
    "headless",
    "rules",
    "dsl"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./workflow": {
      "types": {
        "import": "./dist/workflow/index.d.ts",
        "require": "./dist/workflow/index.d.cts"
      },
      "import": "./dist/workflow/index.js",
      "require": "./dist/workflow/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:isolated": "node scripts/isolated-consumer.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
