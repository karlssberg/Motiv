<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Motiv.Serialization.AspNetCore\Motiv.Serialization.AspNetCore.csproj" />
        <ProjectReference Include="..\..\Motiv.Serialization.EntityFrameworkCore\Motiv.Serialization.EntityFrameworkCore.csproj" />
        <ProjectReference Include="..\..\Motiv.Serialization.Sql\Motiv.Serialization.Sql.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(AssemblyName).Tests" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Rules\loyalty-discount.json" />
    </ItemGroup>

    <!--
        SQLitePCLRaw.lib.e_sqlite3 (transitive via Microsoft.EntityFrameworkCore.Sqlite, pulled in by
        the EF store project reference) is flagged by NuGet audit for GHSA-2m69-gcr7-jv3q
        (CVE-2025-6965), a SQLite memory-corruption issue in an obscure aggregate-query edge case. No
        patched version is published for NuGet yet. The store issues no aggregate queries over
        untrusted input, so the advisory is suppressed here — matching the suppression already carried
        by Motiv.Serialization.EntityFrameworkCore itself.
    -->
    <ItemGroup>
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
    </ItemGroup>

</Project>
