// Mutation testing for src/Motiv, killed by this project's tests (#294).
// Run from this directory: `dotnet tool restore && dotnet tool run dotnet-stryker`.
// See docs/contributing/mutation-testing.md.
{
  "stryker-config": {
    "project": "Motiv.csproj",
    // Stryker mutates one target framework per run. net10.0 is the primary; the `#if` branches only
    // the netstandard2.0 build compiles (the ns20asset leg) are not mutated by this run.
    "target-framework": "net10.0",
    "coverage-analysis": "perTest",
    "mutation-level": "Standard",
    "reporters": [ "html", "json", "progress" ],
    // The full run is report-only: `break` stays 0 so a low score never fails it. The PR gate
    // (mutation-pr.yml) also keeps `break` at 0, and checks each changed file with scripts/mutation/gate.sh.
    "thresholds": { "high": 80, "low": 60, "break": 0 }
  }
}
