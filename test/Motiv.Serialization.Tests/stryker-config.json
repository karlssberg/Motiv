// Mutation testing for src/Motiv.Serialization, killed by this project's tests (#294).
// Run from this directory: `dotnet tool restore && dotnet tool run dotnet-stryker`.
// See docs/contributing/mutation-testing.md.
{
  "stryker-config": {
    // Named explicitly: src/Motiv arrives here as a transitive reference and is not mutated by this
    // run — test/Motiv.Tests owns it.
    "project": "Motiv.Serialization.csproj",
    // Stryker mutates one target framework per run. net10.0 is the primary, as for src/Motiv; the
    // netstandard2.0-only `#if` branches (the ns20asset leg) are not mutated by this run.
    "target-framework": "net10.0",
    "coverage-analysis": "perTest",
    "mutation-level": "Standard",
    "reporters": [ "html", "json", "progress" ],
    // Report-only: this project runs in the scheduled full run alone (#294 step 4), and nothing
    // gates on its score yet.
    "thresholds": { "high": 80, "low": 60, "break": 0 }
  }
}
