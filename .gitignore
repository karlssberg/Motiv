.memsearch/

# Studio host state: the file-backed proposition store's data, not source.
src/Motiv.Studio/propositions.json

# Studio host state: the file-backed gate store's active approval-gate document. Read at startup;
# written once the gate is configured over HTTP (PUT /gate). Deployment state, not source.
src/Motiv.Studio/gate.json

# Studio host state: the file-backed rule store's append-only version log. Read at startup; grows
# every time a rule is hot-swapped over HTTP. Deployment state, not source.
src/Motiv.Studio/rules.json

# Studio host state: the EF Core-backed rule and proposition store's SQLite database (and its
# journal/WAL sidecar files), created in place by EnsureCreatedAsync on startup. Deployment state,
# not source — supersedes rules.json/propositions.json above as the default store.
src/Motiv.Studio/motiv-store.db
src/Motiv.Studio/motiv-store.db-*
# The decision log is a separate database from the authoring store, deliberately — see Spec 3D.
src/Motiv.Studio/motiv-decisions.db
src/Motiv.Studio/motiv-decisions.db-*
