<Project>
    <ItemGroup Condition="'$(IsTestProject)' == 'true'">
        <Compile Include="$(MSBuildThisFileDirectory)test/testing/ShouldlyLineEndingExtensions.cs"
                 Link="ShouldlyLineEndingExtensions.cs" />
    </ItemGroup>

    <!--
      The netstandard2.0 asset leg (see Directory.Build.props): every project reference loads its
      netstandard2.0 build. Done in a target, not a static item update, because the SDK adds the
      TRANSITIVE references (Motiv, under Motiv.Serialization.Tests) in IncludeTransitiveProjectReferences
      — left alone, those resolve to net10.0 and a netstandard2.0 serializer runs over a net10.0 core.
      AfterTargets alone: that target is itself reached from a BeforeTargets="AssignProjectConfiguration"
      hook, so adding the same BeforeTargets here would let this run first and miss what it adds.
    -->
    <Target Name="PinProjectReferencesToNetStandardAsset"
            AfterTargets="IncludeTransitiveProjectReferences"
            Condition="'$(TargetFramework)' == '$(NetStandardAssetLeg)'">
        <ItemGroup>
            <ProjectReference Update="@(ProjectReference)" SetTargetFramework="TargetFramework=netstandard2.0" />
        </ItemGroup>
    </Target>

    <!--
      NuGet restore does not read SetTargetFramework: it restores the leg as the net10.0 it runs
      on, so a package the netstandard2.0 builds need ONLY on that surface is never restored.
      Everything else they reference ships in the shared framework; Microsoft.Bcl.AsyncInterfaces
      does not. Referenced here it resolves to its type-forwarding facade — the same
      IAsyncEnumerable identity the runtime has. TargetAssetTests names any future gap.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == '$(NetStandardAssetLeg)'">
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    </ItemGroup>
</Project>
