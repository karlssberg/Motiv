{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Motiv.Studio"],
      "port": 5100,
      "autoPort": true
    },
    {
      "name": "studio-ui",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "ui/apps/studio", "dev", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
